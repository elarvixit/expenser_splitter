{
  "name": "splitter",
  "private": true,
  "description": "Splitter expense splitter: static site + tests. The site itself needs no install; these packages are for testing only.",
  "type": "commonjs",
  "scripts": {
    "test": "node tests/run-all.mjs",
    "test:unit": "node --test tests/unit/",
    "test:db": "node --test tests/db/",
    "test:e2e": "playwright test",
    "coverage": "node tests/run-all.mjs --coverage"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.x",
    "@playwright/test": "^1.49.0",
    "jspdf": "2.5.1",
    "jspdf-autotable": "3.8.2",
    "monocart-coverage-reports": "^2.11.0"
  }
}
